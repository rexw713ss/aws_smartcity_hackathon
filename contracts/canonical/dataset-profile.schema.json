{
  "$defs": {
    "ColumnProfile": {
      "properties": {
        "distinct_count": {
          "minimum": 0,
          "title": "Distinct Count",
          "type": "integer"
        },
        "distinct_count_is_lower_bound": {
          "default": false,
          "title": "Distinct Count Is Lower Bound",
          "type": "boolean"
        },
        "inferred_type": {
          "$ref": "#/$defs/PrimitiveType"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "non_null_count": {
          "minimum": 0,
          "title": "Non Null Count",
          "type": "integer"
        },
        "null_count": {
          "minimum": 0,
          "title": "Null Count",
          "type": "integer"
        },
        "null_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Null Rate",
          "type": "number"
        },
        "numeric_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Max"
        },
        "numeric_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Min"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "sample_values": {
          "items": {
            "type": "string"
          },
          "title": "Sample Values",
          "type": "array"
        },
        "semantic_confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Semantic Confidence",
          "type": "number"
        },
        "semantic_role": {
          "$ref": "#/$defs/SemanticRole",
          "default": "unknown"
        }
      },
      "required": [
        "name",
        "position",
        "inferred_type",
        "non_null_count",
        "null_count",
        "null_rate",
        "distinct_count"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "FileFormat": {
      "enum": [
        "csv"
      ],
      "title": "FileFormat",
      "type": "string"
    },
    "GeographyCoverage": {
      "properties": {
        "district_count": {
          "default": 0,
          "minimum": 0,
          "title": "District Count",
          "type": "integer"
        },
        "recognized_district_count": {
          "default": 0,
          "minimum": 0,
          "title": "Recognized District Count",
          "type": "integer"
        },
        "unknown_values": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Values",
          "type": "array"
        }
      },
      "title": "GeographyCoverage",
      "type": "object"
    },
    "PrimitiveType": {
      "enum": [
        "empty",
        "boolean",
        "integer",
        "float",
        "date",
        "string"
      ],
      "title": "PrimitiveType",
      "type": "string"
    },
    "ProfileWarning": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/WarningSeverity",
          "default": "warning"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ProfileWarning",
      "type": "object"
    },
    "SemanticRole": {
      "enum": [
        "year",
        "month",
        "district_code",
        "district_name",
        "age_label",
        "age_lower",
        "age_upper",
        "gender",
        "metric",
        "dimension",
        "unknown"
      ],
      "title": "SemanticRole",
      "type": "string"
    },
    "TimeCoverage": {
      "properties": {
        "months": {
          "items": {
            "type": "integer"
          },
          "title": "Months",
          "type": "array"
        },
        "months_by_gregorian_year": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Months By Gregorian Year",
          "type": "object"
        },
        "source_year_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Year System"
        },
        "year_gregorian_max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year Gregorian Max"
        },
        "year_gregorian_min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year Gregorian Min"
        }
      },
      "title": "TimeCoverage",
      "type": "object"
    },
    "WarningSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "WarningSeverity",
      "type": "string"
    }
  },
  "properties": {
    "candidate_grain": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Grain",
      "type": "array"
    },
    "column_count": {
      "minimum": 0,
      "title": "Column Count",
      "type": "integer"
    },
    "columns": {
      "items": {
        "$ref": "#/$defs/ColumnProfile"
      },
      "title": "Columns",
      "type": "array"
    },
    "content_sha256": {
      "title": "Content Sha256",
      "type": "string"
    },
    "delimiter": {
      "title": "Delimiter",
      "type": "string"
    },
    "duplicate_check_is_partial": {
      "default": false,
      "title": "Duplicate Check Is Partial",
      "type": "boolean"
    },
    "duplicate_row_count": {
      "default": 0,
      "minimum": 0,
      "title": "Duplicate Row Count",
      "type": "integer"
    },
    "duplicate_rows_checked": {
      "default": 0,
      "minimum": 0,
      "title": "Duplicate Rows Checked",
      "type": "integer"
    },
    "encoding": {
      "title": "Encoding",
      "type": "string"
    },
    "file_format": {
      "$ref": "#/$defs/FileFormat"
    },
    "file_name": {
      "title": "File Name",
      "type": "string"
    },
    "file_size_bytes": {
      "minimum": 0,
      "title": "File Size Bytes",
      "type": "integer"
    },
    "geography_coverage": {
      "$ref": "#/$defs/GeographyCoverage",
      "default": {
        "district_count": 0,
        "recognized_district_count": 0,
        "unknown_values": []
      }
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "source_path": {
      "format": "path",
      "title": "Source Path",
      "type": "string"
    },
    "time_coverage": {
      "$ref": "#/$defs/TimeCoverage",
      "default": {
        "months": [],
        "months_by_gregorian_year": {},
        "source_year_system": null,
        "year_gregorian_max": null,
        "year_gregorian_min": null
      }
    },
    "truncated_by_max_rows": {
      "default": false,
      "title": "Truncated By Max Rows",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/ProfileWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "source_path",
    "file_name",
    "file_format",
    "encoding",
    "delimiter",
    "file_size_bytes",
    "content_sha256",
    "row_count",
    "column_count",
    "columns"
  ],
  "title": "DatasetProfile",
  "type": "object"
}
