{
  "$defs": {
    "QualityIssue": {
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "severity": {
          "$ref": "#/$defs/WarningSeverity"
        }
      },
      "required": [
        "code",
        "message",
        "severity"
      ],
      "title": "QualityIssue",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "valid",
        "warning",
        "needs_review",
        "rejected"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "WarningSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "WarningSeverity",
      "type": "string"
    }
  },
  "properties": {
    "issues": {
      "items": {
        "$ref": "#/$defs/QualityIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "quality_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Quality Score",
      "type": "number"
    },
    "rows_accepted": {
      "minimum": 0,
      "title": "Rows Accepted",
      "type": "integer"
    },
    "rows_received": {
      "minimum": 0,
      "title": "Rows Received",
      "type": "integer"
    },
    "rows_rejected": {
      "minimum": 0,
      "title": "Rows Rejected",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/QualityStatus"
    }
  },
  "required": [
    "status",
    "quality_score",
    "rows_received",
    "rows_accepted",
    "rows_rejected"
  ],
  "title": "QualityReport",
  "type": "object"
}
