# Default is the same-origin path /api/v1, which the Vite dev proxy forwards to
# the local FastAPI service. Set this only to reach a different origin, which
# then also requires CORS on the backend.
# VITE_COPILOT_API_BASE=/api/v1
#
# Point the dev proxy at a non-default backend origin instead (no CORS needed):
# YOUTH_COMPASS_API_ORIGIN=http://127.0.0.1:8000
#
# Never put model-provider credentials or any secret in a VITE_ variable: every
# VITE_ value is inlined into the public bundle.
