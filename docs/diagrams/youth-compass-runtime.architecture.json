  "cards": [
    {
      "dot": "cyan",
      "title": "One deployed process",
      "items": [
        "A single Lambda holds the API and the whole copilot",
        "Streaming needs a Function URL, so there is no stage to throttle",
        "Reserved concurrency 20 is therefore the only spend cap"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing is answerable by accident",
      "items": [
        "An upload pauses at Step Functions until a human approves its mapping",
        "Only then is an immutable version published and registered",
        "Queries name a registered version, never a bucket path"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cost is measured, not assumed",
      "items": [
        "Athena bills per byte scanned; every turn records what it scanned",
        "A version-keyed cache fronts both reads inside the process",
        "Measured: repeat question 1153 ms → 23 ms, 1.4 MB → 0 bytes"
      ]
    }
  ]
