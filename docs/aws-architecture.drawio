        <mxCell id="notdeployed-box" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#879196;fontFamily=Helvetica;container=0;collapsible=0;dashed=1;strokeColor=#879196;fillColor=none;" value="尚未部署 &#8212; 僅存在於規劃文件" vertex="1" parent="1">
          <mxGeometry x="800" y="950" width="840" height="150" as="geometry" />
        </mxCell>
        <mxCell id="notdeployed-text" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#879196;fontFamily=Helvetica;" value="&#8226; Amazon SageMaker(預測訓練、模型登錄、批次轉換)&#8212; 任何堆疊皆無此構件;預測目前為離線預運算產物。&lt;div&gt;&#8226; Bedrock AgentCore(代理人託管、MCP Gateway)&#8212; 代理人實際在 API Lambda 內同處一程序執行。&lt;/div&gt;&lt;div&gt;&#8226; Bedrock 輔助結構描述對應 &#8212; transform Lambda 未取得任何 Bedrock 權限;對應為決定性信賴度評分。&lt;/div&gt;&lt;div&gt;&#8226; OpenTelemetry 分散式追蹤 &#8212; 僅有 CloudWatch 日誌與指標。&lt;/div&gt;&lt;div&gt;&#8226; forecasts/ 儲存貯體已建立,但尚無任何寫入路徑。&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="814" y="978" width="814" height="112" as="geometry" />
        </mxCell>

        <mxCell id="iam-band" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontStyle=1;fontSize=14;fontColor=#DD344C;fontFamily=Helvetica;container=0;collapsible=0;dashed=1;strokeColor=#DD344C;fillColor=none;" value="IAM 權限邊界 &#8212; 實際由各函式的執行角色強制" vertex="1" parent="1">
          <mxGeometry x="260" y="1180" width="1380" height="200" as="geometry" />
        </mxCell>

        <mxCell id="grp-writerole" style="fillColor=#FFEBEE;strokeColor=#DD344C;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#DD344C;fontFamily=Helvetica;container=1;collapsible=0;shadow=1;strokeWidth=1.5;" value="安全性" vertex="1" parent="1">
