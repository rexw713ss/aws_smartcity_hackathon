.DS_Store
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.venv/

# Generated local databases and model artifacts
*.duckdb
*.sqlite
*.sqlite3
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep

# Runtime data zones; source data remains tracked
data/.staging/
data/incoming/*
!data/incoming/.gitkeep
data/quarantined/*
!data/quarantined/.gitkeep
data/standardized/*
!data/standardized/.gitkeep
data/curated/*
!data/curated/.gitkeep
data/forecasts/*
!data/forecasts/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
data/features/*.parquet

node_modules/
# AWS CDK synthesis output and cached context.
# cdk.context.json must stay untracked: the CDK CLI caches -c values there,
# which is how the budget notification address would otherwise be committed.
cdk.out/
infra/cdk.out/
cdk.context.json
cdk.staging/

# AWS credentials and the real (filled-in) AWS config; only the example is tracked
.aws/
configs/aws.yaml

# Local data export destination written by scripts/aws_export.py before the
# hackathon account is suspended; this is real data, not source.
exports/
# Lambda deployment package built by scripts/build_lambda.py
build/

# Local reports and previews generated during development
output/
